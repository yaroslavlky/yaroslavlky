---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { ui, type Language } from '../../../i18n';
export function getStaticPaths() { return [{ params: { lang: 'en' } }, { params: { lang: 'ru' } }]; }
const lang = Astro.params.lang as Language;
const t = ui[lang];
const articles = (await getCollection('articles', ({ data }) => data.language === lang && !data.draft)).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
---
<BaseLayout lang={lang} title={t.articlesTitle} description={t.articlesLead}>
  <div class="page-intro"><span class="section-kicker">THE JOURNAL / {lang.toUpperCase()}</span><h1>{t.articlesTitle}<span class="accent-dot">.</span></h1><p class="page-lead">{t.articlesLead}</p></div><div class="article-list">{articles.length ? articles.map((article) => <ArticleCard article={article} lang={lang} />) : <p>{t.noArticles}</p>}</div>
</BaseLayout>
