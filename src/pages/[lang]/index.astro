---
import { getCollection } from 'astro:content';
import { ArrowUpRight01Icon, Mail01Icon, TelegramIcon } from '@hugeicons/core-free-icons';
import ArticleCard from '../../components/ArticleCard.astro';
import HugeIcon from '../../components/HugeIcon.astro';
import { assetPath, path, ui, type Language } from '../../i18n';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'ru' } }];
}

const lang = Astro.params.lang as Language;
const t = ui[lang];
const articles = (await getCollection('articles', ({ data }) => data.language === lang && !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 2);
---
<BaseLayout lang={lang} title={t.home} description={t.lead}>
  <section class="hero">
    <img class="portrait" src={assetPath('avatar.jpg')} alt={lang === 'ru' ? 'Ярослав Лукьянчук' : 'Yaroslav Lukyanchuk'} width="128" height="128" />
    <div class="hero-copy">
      <h1>{lang === 'ru' ? 'Ярослав Лукьянчук' : 'Yaroslav Lukyanchuk'}</h1>
      <p class="eyebrow">{t.role}</p>
      <p class="hero-lead">{t.lead}</p>
      <div class="hero-actions">
        <a class="text-link icon-link" href={path(lang, 'articles')}>{t.readArticles}<HugeIcon icon={ArrowUpRight01Icon} /></a>
      </div>
    </div>
  </section>

  <section class="section writing-section">
    <div class="section-heading">
      <div><h2>{t.latestWriting}</h2><p>{t.latestWritingIntro}</p></div>
      <a class="text-link icon-link section-link" href={path(lang, 'articles')}>{t.allArticles}<HugeIcon icon={ArrowUpRight01Icon} /></a>
    </div>
    <div class="article-grid">
      {articles.length ? articles.map((article) => <ArticleCard article={article} lang={lang} />) : <p>{t.noArticles}</p>}
    </div>
  </section>

  <section class="contact-band">
    <div><h2>{t.contact}</h2><p>{t.contactLead}</p></div>
    <div class="contact-links">
      <a class="text-link icon-link" href="mailto:meregodz@gmail.com"><HugeIcon icon={Mail01Icon} />meregodz@gmail.com</a>
      <a class="text-link icon-link" href="https://t.me/nmequalmn" target="_blank" rel="noopener noreferrer"><HugeIcon icon={TelegramIcon} />Telegram</a>
    </div>
  </section>
</BaseLayout>
